# ---------------------------------------------------------------------------
# suNRIseevent '27 — environment template. Copy to .env and fill every value.
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / local / Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/neonova?schema=public"

# Public origin (no trailing slash). Used for links, CORS and CSRF origin checks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth secrets — minimum 32 random bytes each, all different
AUTH_SECRET="replace-me-with-a-long-random-string"
REFRESH_TOKEN_PEPPER="replace-me-with-another-long-random-string"

# Registration QR signing secret
QR_SECRET="replace-me-with-another-long-random-string"

# Session lifetimes
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"

# Email / SMTP. Leave SMTP_HOST empty in development to log emails to storage/mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="suNRIseevent '27 <no-reply@sunriseevent.in>"
# Optional: Resend API key (takes precedence over SMTP when set)
RESEND_API_KEY=""

# Cloudflare Turnstile (captcha). Dev bypasses only when both keys are empty.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Local embedded Postgres helper (scripts/dev.mjs only)
EMBEDDED_DB_PORT="55432"
EMBEDDED_DB_DIR="./storage/db"
# Set false to skip auto db push + seed on `npm run dev`
DEV_AUTO_SETUP="true"

# Seed credentials — change in production
SEED_ADMIN_EMAIL="admin@sunriseevent.in"
SEED_ADMIN_PASSWORD="Admin@Sunrise27"
SEED_STUDENT_EMAIL="student@sunriseevent.in"
SEED_STUDENT_PASSWORD="Student@Sunrise27"
